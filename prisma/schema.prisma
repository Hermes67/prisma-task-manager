// Task Manager - Prisma Schema
// Models: User, Project, Task with full relations, enums, and indexes

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String  @unique
  name      String
  avatarUrl String? @map("avatar_url")
  role      Role    @default(USER)

  // Relations
  ownedProjects   Project[]         @relation("ProjectOwner")
  memberships     ProjectMember[]
  createdTasks    Task[]            @relation("TaskCreator")
  assignedTasks   Task[]            @relation("TaskAssignee")
  taskComments    TaskComment[]

  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?     @map("due_date")

  // Owner relation
  ownerId String @map("owner_id")
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Relations
  members ProjectMember[]
  tasks   Task[]

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

/// Join table for many-to-many User <-> Project membership
model ProjectMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String @map("user_id")
  projectId String @map("project_id")
  role      Role   @default(USER)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @map("due_date")
  completedAt DateTime?  @map("completed_at")

  // Project relation
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Creator
  creatorId String @map("creator_id")
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  // Optional assignee
  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Self-relation for subtasks
  parentId String? @map("parent_id")
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[]  @relation("TaskSubtasks")

  // Relations
  comments TaskComment[]
  tags     TaskTag[]

  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status, priority])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6B7280")

  tasks TaskTag[]

  @@map("tags")
}

/// Join table for many-to-many Task <-> Tag
model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}
